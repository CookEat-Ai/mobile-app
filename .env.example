# Environnement applicatif : development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Optionnel en local : sans valeur, CookEat déduit l'hôte de Metro.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8083/api

EXPO_PUBLIC_APPSFLYER_DEV_KEY=your_appsflyer_dev_key
EXPO_PUBLIC_APPSFLYER_IOS_APP_ID=your_app_store_id

EXPO_PUBLIC_POSTHOG_KEY=your_posthog_project_key
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn

EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your_revenuecat_ios_public_sdk_key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your_revenuecat_android_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=Pro
EXPO_PUBLIC_REVENUECAT_DISCOUNT_OFFERING_ID=discount_80
EXPO_PUBLIC_REVENUECAT_DISCOUNT_PRODUCT_IOS=com.example.app.Annual.Discount
EXPO_PUBLIC_REVENUECAT_DISCOUNT_PRODUCT_ANDROID=annual_discount:base_plan

EXPO_PUBLIC_PRIVACY_URL_FR=https://cookeat.info/privacy/fr
EXPO_PUBLIC_PRIVACY_URL_EN=https://cookeat.info/privacy/en
EXPO_PUBLIC_TERMS_URL_IOS=https://cookeat.info/terms/fr
EXPO_PUBLIC_TERMS_URL_ANDROID=https://cookeat.info/terms/fr
